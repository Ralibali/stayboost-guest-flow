# StayBoost — miljövariabler för frontend (/app-operatörsvy och /g-gästsida)
# Skapa ett Supabase-projekt, kör supabase/migrations/,
# deploya supabase/functions/* och fyll i värdena nedan (t.ex. i .env.local).
# Preview-hosten (*.lovable.app) är inte produktion.

VITE_SUPABASE_URL=https://<PROJEKT-REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-nyckel>

# Single-tenant: lämna false i produktion så slumpkonton inte kan skapa anläggningar.
# Ägarens inloggning påverkas inte. Sätt true bara för att skapa första ägarkontot.
VITE_ALLOW_PUBLIC_SIGNUP=false

# Valfri inbäddad grundarsamtal-länk (Cal.com / Savvycal). Tom = embed dold.
# VITE_PUBLIC_BOOKING_URL=

# Edge-funktionernas hemligheter (sätts i Supabase, INTE här):
# CRON_SECRET, BREVO_API_KEY, BREVO_SENDER_EMAIL, BREVO_SENDER_NAME,
# ELKS_API_USER, ELKS_API_PASSWORD, ELKS_SENDER
#
# Stripe (kortbetalning i bokningsmotorn):
# STRIPE_SECRET_KEY        — secret key från Stripe Dashboard → Developers → API keys
# STRIPE_WEBHOOK_SECRET    — signing secret från Developers → Webhooks
#                            (endpoint: <SUPABASE_URL>/functions/v1/stripe-webhook,
#                             events: checkout.session.completed + checkout.session.expired)
#
# Publik kanonisk värd (gästmejl + Stripe success/cancel).
# Dokumenterad default: https://stayboost.se
# Sätt ALDRIG dessa till *.lovable.app.
# PUBLIC_APP_URL=https://stayboost.se
# GUEST_PAGE_BASE_URL=https://stayboost.se
# PUBLIC_LEADMAGNET_PDF_URL=https://stayboost.se/mallar/stayboost-12-sms.pdf
